{
  "name": "phishclaw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @sentry-ext/extension dev",
    "build": "pnpm --filter @sentry-ext/extension build",
    "zip": "pnpm --filter @sentry-ext/extension zip",
    "worker:fake": "pnpm --filter @sentry-ext/worker dev:fake",
    "demo": "node demo/serve.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
